# =========================================================================
# BACKEND SETTINGS (server/.env)
# =========================================================================

# Port for the Express server to listen on
PORT=5000

# MongoDB Connection URI 
# - For local installation: mongodb://localhost:27017/smart_grocery_db
# - For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/smart_grocery_db
MONGO_URI=mongodb://localhost:27017/smart_grocery_db

# Secret key for signing and validating JWT tokens (use a long, secure random string)
JWT_SECRET=supersecretjwtkey_smartgrocery_123456


# =========================================================================
# MOBILE SETTINGS (mobile/.env or configuration constants)
# =========================================================================

# API Base URL for connecting to the server
# - Android Emulator standard bridge to host machine: http://10.0.2.2:5000/api
# - iOS Simulator: http://localhost:5000/api
# - Physical Android Device: http://<YOUR_COMPUTER_LAN_IP>:5000/api
API_BASE_URL=http://10.0.2.2:5000/api
